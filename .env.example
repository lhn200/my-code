# 复制为 .env 后按需修改；在哪个目录启动服务，就把 .env 放在哪个目录。
# 例如从 backend/ 启动时使用 backend/.env（内容与下面相同）。

# ===== 模型访问 =====
# 必填：模型服务 API Key
LLM_API_KEY=
# 可选：OpenAI 兼容接口地址，留空使用 SDK 默认值
LLM_BASE_URL=
# 模型路由配置，默认使用包内 models.yaml
# MODELS_CONFIG_PATH=app/config/models.yaml
# 角色提示词目录
# PROMPTS_DIR=app/prompts
# 单节点结构化输出失败后的重试次数
# NODE_RETRY_ATTEMPTS=2

# ===== 服务与存储 =====
# API_PATH_PREFIX=/api
# CHECKPOINT_DB_PATH=data/checkpoints.sqlite3
# UPLOAD_DIR=data/uploads

# ===== 工作流预算 =====
# 匹配分达到该值即视为通过
# RESUME_MATCH_THRESHOLD=70
# 单岗位最多优化轮数
# MAX_OPTIMIZATION_ROUNDS=2
# 单次运行最多岗位数
# MAX_JOBS=5
# 并发分析岗位数上限
# MAX_CONCURRENT_JOBS=4
# 单次输入与单岗位文本字符上限
# MAX_INPUT_CHARS=20000
# MAX_JOB_TEXT_CHARS=12000

# ===== 简历摄入 =====
# RESUME_MAX_FILE_MB=5
# 扫描件最多 OCR 页数
# OCR_MAX_PAGES=10
# OCR 文本低于该字符数标记低置信度
# OCR_MIN_CHARS=30

# ===== 会话记忆 =====
# SESSION_CONTEXT_BUDGET=8000
# 各部分 token 预算之和不得超过 SESSION_CONTEXT_BUDGET
# CONTEXT_MEMORY_TOKENS=800
# CONTEXT_SUMMARY_TOKENS=1200
# CONTEXT_RECENT_TURNS_TOKENS=4800
# CONTEXT_CURRENT_INPUT_TOKENS=1200

# RECENT_TURNS_KEEP=6
# MIN_RECENT_TURNS=2
# SUMMARY_TRIGGER_TURNS=12
# SUMMARY_MAX_CHARS=1200
# SUMMARY_TIMEOUT_SECONDS=20
# MAX_MESSAGE_CHARS=4000

# MEMORY_ENABLED_DEFAULT=false
# MEMORY_TOP_K=5
# MEMORY_MAX_TOP_K=8
# MEMORY_MAX_CONTENT_CHARS=200
# MEMORY_MIN_CONFIDENCE=0.7
# MEMORY_PENDING_CONFIDENCE=0.4

# 记忆 TTL，0 表示永不过期
# MEMORY_TTL_DAYS_FACT=180
# MEMORY_TTL_DAYS_GOAL=365
# MEMORY_TTL_DAYS_PREFERENCE=0
# MEMORY_TTL_DAYS_CONSTRAINT=0
